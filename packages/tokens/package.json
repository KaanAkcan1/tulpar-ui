{
  "name": "@tulpar-ui/tokens",
  "version": "0.6.0",
  "description": "Design tokens for Tulpar UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fallbacks": {
      "types": "./dist/fallbacks.d.ts",
      "import": "./dist/fallbacks.js"
    },
    "./css/tulpar-light.css": "./dist/css/tulpar-light.css",
    "./css/tulpar-dark.css": "./dist/css/tulpar-dark.css",
    "./css/tulpar.css": "./dist/css/tulpar.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsx build/generate-fallbacks.ts && vite build && tsx build/generate-css.ts",
    "build:css": "tsx build/generate-css.ts",
    "build:fallbacks": "tsx build/generate-fallbacks.ts",
    "dev": "pnpm run build:fallbacks && pnpm run build:css && vite build --watch",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
