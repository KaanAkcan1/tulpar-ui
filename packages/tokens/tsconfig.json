{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Published .d.ts must not map to src/, which is not in the tarball (INF-17).
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "build", "**/*.test.ts"]
}
