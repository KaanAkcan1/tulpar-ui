{
  "name": "@tulpar-ui/angular",
  "version": "0.6.0",
  "description": "Angular wrappers for Tulpar UI Web Components",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json",
    "dev": "ng-packagr -p ng-package.json -c tsconfig.json --watch",
    "test": "vitest run",
    "test:ci": "vitest run",
    "typecheck": "tsc -p tsconfig.lib.prod.json --noEmit"
  },
  "dependencies": {
    "@tulpar-ui/core": "workspace:^",
    "@tulpar-ui/shell": "workspace:^",
    "@tulpar-ui/tokens": "workspace:^"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/router": "^22.0.0"
  },
  "peerDependenciesMeta": {
    "@angular/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.6",
    "@analogjs/vitest-angular": "^2.9.6",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/router": "^22.0.0",
    "happy-dom": "^21.0.4",
    "ng-packagr": "^22.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist",
    "linkDirectory": true
  }
}
