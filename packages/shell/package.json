{
  "name": "@tulpar-ui/shell",
  "version": "0.6.0",
  "description": "Application shell components for Tulpar UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nav-item": {
      "types": "./dist/nav-item/index.d.ts",
      "import": "./dist/nav-item/index.js"
    },
    "./nav-section": {
      "types": "./dist/nav-section/index.d.ts",
      "import": "./dist/nav-section/index.js"
    },
    "./persist": {
      "types": "./dist/persist/index.d.ts",
      "import": "./dist/persist/index.js"
    },
    "./shell": {
      "types": "./dist/shell/index.d.ts",
      "import": "./dist/shell/index.js"
    },
    "./sidenav": {
      "types": "./dist/sidenav/index.d.ts",
      "import": "./dist/sidenav/index.js"
    },
    "./topbar": {
      "types": "./dist/topbar/index.d.ts",
      "import": "./dist/topbar/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/*/index.js",
    "./dist/tulpar-*.js"
  ],
  "scripts": {
    "sync-exports": "tsx ../../scripts/sync-exports.ts .",
    "sync-exports:check": "tsx ../../scripts/sync-exports.ts . --check",
    "build": "tsx ../../scripts/sync-exports.ts . && vite build && cem analyze",
    "dev": "vite build --watch",
    "test": "wtr-strict",
    "test:all-browsers": "wtr-strict && wtr-strict --config web-test-runner.engines.config.js",
    "test:ci": "wtr-strict --coverage && wtr-strict --config web-test-runner.engines.config.js",
    "test:watch": "wtr --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@tulpar-ui/tokens": "workspace:^",
    "lit": "catalog:"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "catalog:",
    "@open-wc/testing": "^5.0.0",
    "@tulpar-ui/test-utils": "workspace:^",
    "@types/mocha": "^10.0.6",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.0.2",
    "@web/test-runner-playwright": "^1.0.1",
    "playwright": "^1.65.0",
    "tsx": "^4.7.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "customElements": "custom-elements.json"
}
